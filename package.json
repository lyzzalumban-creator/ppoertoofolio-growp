{
  "name": "portofolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dasbor portofolio investasi pribadi: data di Google Sheet (lewat Apps Script), harga diperbarui sekali sehari.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "update": "node scripts/update.mjs",
    "update:dry": "node scripts/update.mjs --dry-run",
    "serve": "python3 -m http.server 8080",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "node test/e2e/run.cjs",
    "versi": "node scripts/web-version.mjs"
  }
}
